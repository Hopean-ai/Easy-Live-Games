{
  "name": "Hub",
  "tree": {
    "$className": "DataModel",
    "HttpService": {
      "$properties": { "HttpEnabled": true }
    },
    "ReplicatedStorage": {
      "HubShared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "HubServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "HubClient": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    }
  }
}
