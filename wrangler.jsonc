{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easy-live-games",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PongRoom" },
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PongRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts", "Matchmaker"] }
  ],
  // Pull request builds run `wrangler preview`. Binding the class with no script_name gives each
  // Preview its own Durable Object namespace, so preview rooms and accounts never touch production ones.
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "ROOMS", "class_name": "PongRoom" },
        { "name": "ACCOUNTS", "class_name": "Accounts" },
        { "name": "MATCHMAKER", "class_name": "Matchmaker" }
      ]
    }
  },
  "observability": { "enabled": true }
}
